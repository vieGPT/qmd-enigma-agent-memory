    {
      "id": "claim_b7a8351c0842406683eb8245910715fc",
      "statement": "In dist mode the bin/qmd launcher selects its runner from lockfiles rather than PATH: package-lock.json selects node, bun.lock or bun.lockb selects bun, and with no lockfile it defaults to node.",
      "evidence": [
        {
          "resource": "repo://bin/qmd#L149-L160",
          "version": "repo-lines-v1:sha256:a2d98aef18c37aad65532c23eeaa7031693b9cf4f29f322667409640a80a765a:"
        }
      ]
    },
    {
      "id": "claim_b737195c9bce42dc864b8ec014d98a1b",
      "statement": "The bin/qmd launcher enters source mode only when the package is not installed under a node_modules segment (unless QMD_SOURCE_MODE overrides) and a .git directory and src/cli/qmd.ts exist; otherwise it runs the compiled dist/cli/qmd.js and exits 1 with a build hint if that file is missing.",
      "evidence": [
        {
          "resource": "repo://bin/qmd#L116-L121",
          "version": "repo-lines-v1:sha256:bb9c64672ce0c69642d0cd7e7af924be73bf309ca05be0d60115a15422082c82:"
