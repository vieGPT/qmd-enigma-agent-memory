    {
      "id": "claim_2da17a310cf54a7d9e53baacc93fca95",
      "statement": "The blended score is rrfWeight * (1/rrfRank) + (1 - rrfWeight) * rerankScore, where 1/rrfRank is positional rather than the RRF sum; results are then sorted by blended score descending, deduplicated by file, filtered by minScore (default 0), and sliced to limit (default 10).",
      "evidence": [
        {
          "resource": "repo://src/store.ts#L6505-L6540",
          "version": "repo-lines-v1:sha256:cb38fcef92ed4dca3a8d90cbdeab647b996903bf426d897561f51fbe3b0fda69:"
