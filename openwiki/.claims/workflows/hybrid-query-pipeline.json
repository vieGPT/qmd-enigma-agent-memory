  "claims": [
    {
      "id": "claim_15ff9d23d0ca463abd58399eee5ae7ef",
      "statement": "hybridQuery in src/store.ts is the orchestrator for plain-text queries: the SDK search({query}) path, the CLI query command, and the MCP query tool all reach it, while search({queries}) instead dispatches to structuredSearch with caller-supplied typed sub-queries.",
      "evidence": [
        {
          "resource": "repo://src/cli/qmd.ts#L3247-L3262",
          "version": "repo-lines-v1:sha256:6d3730a6b5957cd772b71fff65395235f28b4dfa9ba5481890330bc6b34fc760:"
        },
        {
          "resource": "repo://src/index.ts#L489-L528",
          "version": "repo-lines-v1:sha256:ebf29bc15e9107f4ef41809575faad26a255708ff6dcd00ccd20af7fa46e7cf7:"
        },
