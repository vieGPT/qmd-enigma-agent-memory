        }
      ]
    },
    {
      "id": "claim_068b78524feb4ddc920110d556adfc47",
      "statement": "The Host check is enforced whenever the bind address is a concrete interface: the bind address itself is added to the allowed hosts, and a Host header passes only if it is loopback or appears in the allowed hosts; a wildcard bind (empty, 0.0.0.0, ::, [::], or *) enforces Host only when QMD_ALLOWED_HOSTS supplies an allowlist.",
      "evidence": [
        {
          "resource": "repo://src/mcp/origin-guard.ts#L111-L122",
          "version": "repo-lines-v1:sha256:af6938c5383e44894316e9a17080c75e2958be64d33486afe8b8e8220360a719:"
