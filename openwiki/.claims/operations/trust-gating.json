  "claims": [
    {
      "id": "claim_fc9fccad435a47ad8ed235246083a817",
      "statement": "Only three field kinds in a project-local .qmd config are gated: collection update hooks, collection paths resolving outside the project, and model URIs that differ from the built-in defaults. The global config is never gated, and in-project paths and default model URIs need no approval.",
      "evidence": [
        {
          "resource": "repo://src/trust.ts#L1-L17",
          "version": "repo-lines-v1:sha256:df10daf3b5163016ad2908c408c0f3f73f45722229964c9cef456ceca013dfc7:"
        },
        {
          "resource": "repo://src/trust.ts#L135-L159",
          "version": "repo-lines-v1:sha256:1a922df10ce56c0a4cd7cb0a289ebf57794b5affaca4ead05f43bf48cf3db513:"
        }
      ]
    },
    {
      "id": "claim_17a253e3e3b34faf80c82723e728d380",
      "statement": "A config is treated as project-local only when its parent directory is named .qmd; the CLI discovers it by walking upward from the working directory for .qmd/index.yaml then .qmd/index.yml.",
      "evidence": [
        {
          "resource": "repo://src/collections.ts#L141-L155",
          "version": "repo-lines-v1:sha256:896f04a0ac2a276de07bff1b0bae7961121740c44023fac6111974adbcb5bfb1:"
