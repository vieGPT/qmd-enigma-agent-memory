    },
    {
      "id": "claim_4970ded6560d46649772342006478605",
      "statement": "For structured queries, bm25 runs searchLex once per lex line and vector runs searchVector once per vec or hyde line, and the combined file list is deduplicated keeping first occurrences and truncated to the limit.",
      "evidence": [
        {
          "resource": "repo://src/bench/bench.ts#L108-L144",
