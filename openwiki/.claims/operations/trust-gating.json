        }
      ]
    },
    {
      "id": "claim_022e37163baa49bca006f6d397870be2",
      "statement": "Approvals persist in trusted.json under getConfigDir(), which honours QMD_CONFIG_DIR, then XDG_CONFIG_HOME/qmd, then ~/.config/qmd. Records are keyed by the resolved absolute config path and hold the approved digest and a trustedAt timestamp.",
      "evidence": [
        {
          "resource": "repo://src/collections.ts#L119-L130",
          "version": "repo-lines-v1:sha256:bb0132fa85d806c2359257cce712631edeb0ee88fca3d30b2512932241d2828b:"
