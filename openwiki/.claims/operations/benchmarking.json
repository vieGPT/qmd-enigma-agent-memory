    },
    {
      "id": "claim_2148eadfd19b44f69fbe1472814fd4dc",
      "statement": "precision_at_k equals hits within the first expected_in_top_k results divided by min(expected_in_top_k, number of expected files), and is 0 when there are no expected files.",
      "evidence": [
        {
          "resource": "repo://src/bench/score.ts#L47-L58",
          "version": "repo-lines-v1:sha256:d5cde1c09139d6d495801490fffc1c78606bb51a59d2c1bfb52ca43d5e9a0276:"
