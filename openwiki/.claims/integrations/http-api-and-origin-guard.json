          "version": "repo-lines-v1:sha256:3c3e41ac6a041686ab46ce3381a402604a77c8c7a9045254a0604fb58c256d6c:"
        }
      ]
    },
    {
      "id": "claim_c2c9038489034abb9fd90c2738cff116",
      "statement": "0.0.0.0 is deliberately not treated as a loopback hostname, so an Origin of http://0.0.0.0 is untrusted and wildcard binds never get a loopback exemption for that address.",
      "evidence": [
        {
          "resource": "repo://src/mcp/origin-guard.ts#L18-L24",
          "version": "repo-lines-v1:sha256:d7fc5144c1de75d334950ba26a051cae834c5f744027d0bfcabfeda24cd690d7:"
