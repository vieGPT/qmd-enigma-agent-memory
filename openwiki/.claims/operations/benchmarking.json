    {
      "id": "claim_489ec5d26c34403cb0be0b71de5d6cf1",
      "statement": "A benchmark fixture is a JSON object typed BenchmarkFixture with description, a numeric version, an optional collection, and a queries array; each query has id, query, a type from exact, semantic, topical, cross-domain, or alias, description, expected_files, and expected_in_top_k.",
      "evidence": [
        {
          "resource": "repo://src/bench/types.ts#L1-L40",
