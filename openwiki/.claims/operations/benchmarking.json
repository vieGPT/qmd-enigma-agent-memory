        }
      ]
    },
    {
      "id": "claim_40afc72c0ed243a5a3c3b082542fffb1",
      "statement": "The loader only validates that the fixture's queries field is an array and throws 'Invalid fixture: missing queries array' otherwise; other fixture fields are not validated.",
      "evidence": [
        {
          "resource": "repo://src/bench/bench.ts#L325-L345",
