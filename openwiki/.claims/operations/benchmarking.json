    },
    {
      "id": "claim_8c973e615f6e46c9a4500753f465f8b8",
      "statement": "Structured query strings use one-per-line lex:, vec:, hyde:, and a single intent: prefix; multi-line queries require a prefix on every non-empty line, and an intent with no sub-query or a repeated intent is rejected.",
      "evidence": [
