    {
      "id": "claim_3b7a3f7a51b445c494d6434a019e11f2",
      "statement": "The bench harness defines four backends: bm25 calls searchLex, vector calls searchVector, hybrid calls store.search with rerank false, and full calls store.search with rerank true.",
      "evidence": [
        {
          "resource": "repo://src/bench/bench.ts#L108-L166",
          "version": "repo-lines-v1:sha256:7e334a7420b152f6452a07c5963076100a3353950e66cb26eaccb2dfdc7ee65e:"
