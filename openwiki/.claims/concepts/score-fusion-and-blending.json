    {
      "id": "claim_99e818b4ca164845bb028774e3648a59",
      "statement": "After RRF summation, reciprocalRankFusion adds an unweighted top-rank bonus once per file: +0.05 if the file's best 0-indexed rank is 0 and +0.02 if it is 1 or 2. The bonus exceeds the base contribution of a rank-1 entry in a list weighted 2.0 (2/61 is about 0.033), so it dominates fused scores for top-ranked documents.",
      "evidence": [
        {
          "resource": "repo://src/store.ts#L5371-L5414",
          "version": "repo-lines-v1:sha256:2204ccbd5ef140e3a601551d89fb1b96a4beca449f5e9c1f04fdadc93420a0a5:"
        }
      ]
    },
