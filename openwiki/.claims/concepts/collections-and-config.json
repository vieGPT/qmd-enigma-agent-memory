    {
      "id": "claim_e6e9df061ef54742918221345e33b4ea",
      "statement": "syncConfigToDb computes a SHA-256 digest of the config JSON and skips the sync when store_config.config_hash already matches; otherwise it upserts all configured collections, deletes store_collections rows absent from the config, writes or clears global_context, and stores the new hash.",
      "evidence": [
        {
          "resource": "repo://src/store.ts#L1503-L1537",
