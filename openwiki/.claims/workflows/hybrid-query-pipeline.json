    {
      "id": "claim_29d3ca5c6f5440d6a9b1f0072bd40ea0",
      "statement": "With skipRerank, hybridQuery returns before the reranker and blend step, scoring each candidate as 1 divided by its fused rank, keeping candidates without chunks using their full body as the best chunk, and applying dedup, minScore, and limit.",
