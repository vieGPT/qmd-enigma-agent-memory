    {
      "id": "claim_ca506b32dfea44cfa9d3f5220b60a860",
      "statement": "A missing, unparseable, or non-object trust file loads as an empty store, so a corrupt trusted.json never grants blanket trust; an approval is valid only when the stored digest equals the currently computed digest for that config path.",
      "evidence": [
        {
          "resource": "repo://src/trust.ts#L209-L220",
