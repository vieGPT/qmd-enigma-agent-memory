    {
      "id": "claim_029f5f20e59743738908a18396e77389",
      "statement": "reciprocalRankFusion sums weight/(k+rank+1) per file across ranked lists using 0-indexed rank, with default weight 1.0 and default k=60; hybridQuery and structuredSearch call it without passing k, so the search paths always use k=60.",
      "evidence": [
        {
          "resource": "repo://src/store.ts#L5371-L5414",
          "version": "repo-lines-v1:sha256:2204ccbd5ef140e3a601551d89fb1b96a4beca449f5e9c1f04fdadc93420a0a5:"
