    {
      "id": "claim_fe4d1ce2cb7142db89bbf71e3da4adc1",
      "statement": "If a backend throws during a query, the harness records a zeroed backend result with all expected files unmatched and still records latency, so a failing backend lowers its averages instead of aborting the run.",
      "evidence": [
        {
          "resource": "repo://src/bench/bench.ts#L167-L198",
          "version": "repo-lines-v1:sha256:ea415f927b1a0e1019d71e5167939341b07a72381101b54335cdd5b6e1d3a943:"
        }
