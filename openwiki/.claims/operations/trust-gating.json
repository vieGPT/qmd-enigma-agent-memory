    {
      "id": "claim_695305a9afe64cd788f14c1c85cea699",
      "statement": "decideLocalConfigGate returns run when no gated items exist, run when an env opt-in is set, run for a non-project-local config, and run when the stored digest matches; otherwise it returns prompt for an interactive caller and skip for a non-interactive one.",
