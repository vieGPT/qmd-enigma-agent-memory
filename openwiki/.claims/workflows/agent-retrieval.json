        }
      ]
    },
    {
      "id": "claim_c468e4fcba4044bca6f122271a8e61de",
      "statement": "Output format is chosen by --format with the values cli, json, csv, md, xml, or files; an unknown value prints the valid list and exits 1, and the legacy boolean flags (--csv, --md, --xml, --files, --json) apply only when --format is absent.",
