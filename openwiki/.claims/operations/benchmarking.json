        }
      ]
    },
    {
      "id": "claim_6740e655fa384f7988d094cc6266a01f",
      "statement": "recall equals the number of expected files matched anywhere in the full result list divided by the number of expected files, and recall_at_1, recall_at_3, and recall_at_5 are the same ratio restricted to the first 1, 3, or 5 results.",
      "evidence": [
        {
          "resource": "repo://src/bench/score.ts#L61-L100",
          "version": "repo-lines-v1:sha256:a3c945c28b68c9adcbdbcb18654db820e42e76900e5fdeb63629b7f6f8e6cdf2:"
        }
      ]
    },
    {
      "id": "claim_b275191769064ed6b09bdeb3743413cf",
      "statement": "MRR is 1 divided by the 1-based rank of the first result matching any expected file, and 0 when no result matches.",
      "evidence": [
        {
          "resource": "repo://src/bench/score.ts#L76-L86",
          "version": "repo-lines-v1:sha256:b429ea2052963b9aa647fec49460c10b99e5c0de5544c6e6f15ef8241a0894be:"
